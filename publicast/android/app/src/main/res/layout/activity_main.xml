<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Zona de contenido: aquí se crean las zonas del layout (y el lienzo del videowall) -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true" />

    <TextView
        android:id="@+id/announce"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Configuración inicial -->
    <ScrollView
        android:id="@+id/setupScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Escriba la dirección del servidor PubliCast\n(por ejemplo http://192.168.1.10:8080)"
                android:textColor="#CBD5E1"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:background="@drawable/input_bg"
                android:hint="http://servidor:8080"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="20sp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_bg"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:text="Conectar"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/setupError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#FCA5A5"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Emparejamiento -->
    <LinearLayout
        android:id="@+id/pairingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Introduzca este código en el panel de administración\n(Pantallas → Autorizar una pantalla nueva)"
            android:textColor="#CBD5E1"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pairCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.15"
            android:text="······"
            android:textColor="#FFFFFF"
            android:textSize="84sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sin contenido -->
    <LinearLayout
        android:id="@+id/idleScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/idleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PubliCast"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idleMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#CBD5E1"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Identificar: número grande de la pantalla, como en Windows -->
    <FrameLayout
        android:id="@+id/identify"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:foreground="@drawable/identify_frame"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/identifyBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="40dp"
            android:background="@drawable/identify_box"
            android:gravity="center_horizontal"
            android:minWidth="200dp"
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingTop="8dp"
            android:paddingRight="40dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/identifyNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="160sp" />

            <TextView
                android:id="@+id/identifyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/identifyDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CBD5E1"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#99000000"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
